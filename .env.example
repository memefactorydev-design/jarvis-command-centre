# Copy to .env (or just use the dashboard's ⚙ Connections panel / `npm run setup`, which write this file for you).
# .env is git-ignored and should be chmod 600. Never commit real keys.

# Brain — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voice — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Only for hosted deployments (npm run deploy creates one if missing): gates the paid live endpoints.
JARVIS_ACCESS_CODE=

# Optional: only for tools/gen_assets.py (regenerating the artwork with Google's image models)
GEMINI_API_KEY=
